#!/bin/bash
# Resolve exactly the configured Omarchy default agent. Never fall back.
# This is deliberately run for every Scope invocation: the default agent is
# dynamic Omarchy user state, not plugin-lifetime configuration.
set -euo pipefail
configured="${OMARCHY_DEFAULT_AGENT:-}"
if [[ -z $configured ]] && command -v omarchy-default-agent >/dev/null 2>&1; then configured=$(omarchy-default-agent 2>/dev/null || true); fi
configured=$(printf '%s' "$configured" | tr '[:upper:]' '[:lower:]' | xargs)
[[ -n $configured ]] || { echo unknown; exit 1; }
echo "$configured"
